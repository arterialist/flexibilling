{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arterialist.github.io/flexibilling/flexibilling.schema.json",
  "title": "FlexiBilling declarative contract",
  "type": "object",
  "required": ["contract", "identity", "enums", "records", "ports", "algorithms", "lifecycle", "invariants"],
  "properties": {
    "contract": {
      "type": "object",
      "required": ["id", "version", "status", "numeric_model"],
      "properties": {
        "id": {"const": "flexibilling"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "status": {"const": "normative"},
        "description": {"type": "string"},
        "numeric_model": {"type": "object"}
      },
      "additionalProperties": true
    },
    "identity": {"type": "object"},
    "enums": {"type": "object"},
    "records": {"type": "object"},
    "ports": {"type": "object"},
    "algorithms": {"type": "object"},
    "lifecycle": {"type": "object"},
    "invariants": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
